# Default values are provided for development. 
# Override these with actual values for production deployment.

# Database
POSTGRES_USER=omnichat
POSTGRES_PASSWORD=changeme
POSTGRES_DB=omnicore

# OmniRoute Gateway
OMNI_ROUTE_BASE_URL=http://localhost:20128
