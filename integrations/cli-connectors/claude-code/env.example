# Claude Code expects Anthropic-compatible APIs. Route via OmniRoute only if your gateway/proxy
# exposes an Anthropic-compatible endpoint or translation layer for Claude Code.
# Direct OpenAI-compatible /v1 is typically used with OpenAI-style CLIs (Aider, Continue, Codex, etc.).

# Example (adjust to your gateway/proxy capabilities):
# export ANTHROPIC_BASE_URL=http://192.168.176.22:20128
# export ANTHROPIC_API_KEY=<omniroute-or-proxy-key>

# For NEXUS tool access from shell hooks/commands:
export OMNICORE_BASE_URL=http://127.0.0.1:8002
export OMNICORE_API_KEY=<INTERNAL_API_KEY>
