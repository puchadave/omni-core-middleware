# OMNI-CORE (central orchestration) - Shopware is Commerce Execution Layer only
OMNI_CORE_ENABLED=true
OMNI_CORE_BASE_URL=http://127.0.0.1:8002
OMNI_CORE_API_KEY=

# Shopware Node integration (configured on Shopware LXC, referenced by OMNI-CORE)
SHOPWARE_BASE_URL=
SHOPWARE_API_CLIENT_ID=
SHOPWARE_API_CLIENT_SECRET=
SHOPWARE_WEBHOOK_SECRET=

# Sync / policy (OMNI-CORE authority)
OMNI_CORE_SYNC_MODE=api_webhook_only
OMNI_CORE_SYNC_IDEMPOTENCY=true
OMNI_CORE_CONFLICT_STRATEGY=report_only_no_silent_overwrite
